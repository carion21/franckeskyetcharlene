<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Connexion — Backoffice</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="stylesheet" href="/shared/fonts.css">
<link rel="stylesheet" href="/shared/palette.css">
<link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="admin admin--centered">

<main class="login">
  <header class="login__head">
    <p class="login__mark t-script">F &amp; C</p>
    <h1 class="login__title t-label">Backoffice</h1>
  </header>

  <% if (error) { %>
    <%# Message unique quelle que soit la cause : ne jamais révéler si le
        compte existe (PRD §6). %>
    <p class="alert" role="alert"><%= error %></p>
  <% } %>

  <form class="login__form" method="post" action="/admin/login">
    <div class="field">
      <label class="field__label t-label" for="username">Identifiant</label>
      <input class="field__input" id="username" name="username" type="text"
             value="<%= username %>" autocomplete="username" required autofocus>
    </div>

    <div class="field">
      <label class="field__label t-label" for="password">Mot de passe</label>
      <%# Le bouton « œil » est ajouté par shared/admin.js, jamais ici : sans
          JavaScript il ne serait qu'un bouton qui ne fait rien. %>
      <div class="field__control" data-password-toggle>
        <input class="field__input field__input--toggled" id="password" name="password"
               type="password" autocomplete="current-password" required>
      </div>
    </div>

    <button class="btn btn--gold t-label" type="submit">Se connecter</button>
  </form>
</main>

<script src="/shared/admin.js" defer></script>

</body>
</html>
