# Copy to .env and fill in. Never commit .env — real secrets stay out of git.

# MySQL — format: mysql://user:password@host:port/database
DATABASE_URL=

# Express session — long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# MinIO — object storage for generated invitation PDFs
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# Backoffice admin — password is hashed with bcrypt at startup, never stored in clear
ADMIN_USERNAME=
ADMIN_PASSWORD=

# URL publique du site — origine seule, sans chemin ni barre finale.
# Sert aux QR codes imprimés, aux liens du .ics et aux aperçus de partage
# (Open Graph) : tous ont besoin d'une URL absolue.
#
# OBLIGATOIRE quand NODE_ENV=production : le démarrage échoue si elle manque
# ou si elle est malformée. C'est voulu — un QR imprimé avec la mauvaise
# valeur est irrattrapable, mieux vaut ne pas démarrer.
# En dev, laisser vide : repli automatique sur http://localhost:$PORT.
#
# Exemple : PUBLIC_BASE_URL=https://franckeskyetcharlene.geasscorp.com
PUBLIC_BASE_URL=

PORT=3000
